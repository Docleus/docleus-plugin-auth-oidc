{
  "name": "@docleus/plugin-auth-oidc",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "description": "Sign-in through OpenID Connect providers.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./server": "./dist/server/index.js",
    "./docleus.plugin.json": "./docleus.plugin.json"
  },
  "files": [
    "dist",
    "docleus.plugin.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "oxlint -c node_modules/@docleus/config/oxlintrc.json src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise src --config dependency-cruiser.cjs",
    "license": "license-checker-rseidelsohn --summary --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;BlueOak-1.0.0;CC0-1.0;Python-2.0;CC-BY-3.0;(MIT AND CC-BY-3.0)\" --excludePrivatePackages --excludePackages \"lightningcss@1.33.0\"",
    "test": "vitest run",
    "test:dex": "pnpm build && vitest run --config tests/dex/vitest.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm deps && pnpm license && pnpm test"
  },
  "peerDependencies": {
    "@docleus/sdk": ">=0.0.1 <0.0.10"
  },
  "dependencies": {
    "openid-client": "6.8.8"
  },
  "devDependencies": {
    "@docleus/config": "link:../docleus-core/packages/config",
    "@docleus/core-authz": "link:../docleus-core/packages/core-authz",
    "@docleus/core-http": "link:../docleus-core/packages/core-http",
    "@docleus/core-identity": "link:../docleus-core/packages/core-identity",
    "@docleus/core-storage": "link:../docleus-core/packages/core-storage",
    "@docleus/sdk": "link:../docleus-core/packages/sdk",
    "@docleus/server": "link:../docleus-core/packages/server",
    "@docleus/testing": "link:../docleus-core/packages/testing",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "jose": "6.2.13",
    "kysely": "0.29.7",
    "license-checker-rseidelsohn": "5.0.1",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Docleus/docleus-plugin-auth-oidc.git"
  },
  "bugs": {
    "url": "https://github.com/Docleus/docleus-plugin-auth-oidc/issues"
  },
  "homepage": "https://github.com/Docleus/docleus-plugin-auth-oidc#readme"
}
